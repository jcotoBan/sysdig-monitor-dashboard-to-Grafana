# Sysdig Monitor to Grafana Converter
# Copy this file to .env and fill in your values

# Your Sysdig Monitor API token (required for API mode)
SYSDIG_MONITOR_TOKEN=your-api-token-here

# Sysdig Monitor region URL (optional, defaults to us4)
# Uncomment and change to your region if needed:
# SYSDIG_MONITOR_URL=https://app.us4.sysdig.com     # US4 (default)
# SYSDIG_MONITOR_URL=https://app.sysdig.com          # US1
# SYSDIG_MONITOR_URL=https://us2.app.sysdig.com      # US2
# SYSDIG_MONITOR_URL=https://app.us3.sysdig.com      # US3
# SYSDIG_MONITOR_URL=https://eu1.app.sysdig.com      # EU1
# SYSDIG_MONITOR_URL=https://app.eu2.sysdig.com      # EU2
# SYSDIG_MONITOR_URL=https://app.au1.sysdig.com      # AU1
# SYSDIG_MONITOR_URL=https://app.in1.sysdig.com      # IN1
# SYSDIG_MONITOR_URL=https://app.jp1.sysdig.com      # JP1
